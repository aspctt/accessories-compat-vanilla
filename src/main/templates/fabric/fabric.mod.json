{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [${mod_authors_json}],
  "license": "${mod_license}",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.aspctt.accessoriescompatvanilla.fabric.AccessoriesCompatVanillaFabric"],
    "client": ["com.aspctt.accessoriescompatvanilla.fabric.AccessoriesCompatVanillaFabricClient"]
  },
  "mixins": ["${mod_id}.mixins.json"],
  "depends": {
    "fabricloader": "${loader_version_range}",
    "minecraft": "${minecraft_version_range}",
    "java": ">=${java_version}",
    "fabric-api": "*",
    "accessories": "${accessories_version_range}"
  }
}
